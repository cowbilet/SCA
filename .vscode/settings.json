{
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "workbench.settings.enableNaturalLanguageSearch": false,
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "[javascript]": {
    "editor.maxTokenizationLineLength": 2500
  },
  "editor.codeLens": false
}
